# frontend/.env.local  —  CSAK HELYI FEJLESZTÉSHEZ.
# Élesben (docker compose) a gyökér .env + a docker-compose.yml adja az értékeket.
# TITKOT (jelszó, kulcs) IDE SOHA NE írj — ez a fájl verziókövetett!

# A backend API elérhetősége szerver-oldali (SSR) fetch-hez:
BACKEND_URL="http://localhost:4000"

# Böngésző-oldali fetch alap útvonala (a Next.js rewrites proxyzza a backendre):
NEXT_PUBLIC_API_BASE="/api"

# A publikus oldal kanonikus URL-je (sitemap, meta, canonical, JSON-LD):
SITE_URL="http://localhost:3000"

# Az email küldést a BACKEND intézi — annak a beállításai a gyökér .env-ben vannak
# (SMTP_HOST / SMTP_USER / SMTP_PASS stb.), NEM itt.
