# Postgres — indítsd:  npm run dev:db   (a gyökérből)
DATABASE_URL="postgresql://noir:devpassword@localhost:5432/noirbykriszta?schema=public"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="valts-ezt-egy-hosszu-veletlen-titokra"
JWT_EXPIRES_IN="7d"

ADMIN_EMAIL="admin@noirbykriszta.hu"
ADMIN_PASSWORD="noir-admin-2026"

UPLOAD_DIR="./uploads"

SLOT_STEP_MINUTES=30
MIN_LEAD_HOURS=12

# ── Email ── (helyi fejlesztéshez üresen hagyva: konzolra logol)
