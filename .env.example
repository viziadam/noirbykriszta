####################################################################
#  Noir by Kriszta — TELEPÍTÉSI beállítások (docker compose)
#
#  Másold le:   cp .env.example .env      majd töltsd ki az értékeket.
#  A .env-t SOHA ne töltsd fel gitbe / ne oszd meg. (A .gitignore kizárja.)
#  A TITKOKAT (jelszavak, tokenek) MINDIG csak a .env-be írd, ide NE!
####################################################################

# ─────────────────────────  DOMAIN  ─────────────────────────
# Amíg nincs saját domain: DuckDNS aldomain (lásd COMPOSE_PROFILES lentebb).
# Csak a hosztnevet írd ide (protokoll nélkül):
SITE_DOMAIN=noirbykriszta.duckdns.org
# A teljes URL (ezt használják az appok: meta, sitemap, canonical, linkek):
SITE_URL=https://noirbykriszta.duckdns.org

# ── Saját domain esetén később csak ezt a két sort kell átírni: ──
#   SITE_DOMAIN=noirbykriszta.hu
#   SITE_URL=https://noirbykriszta.hu
# (több domain: SITE_DOMAIN="noirbykriszta.hu www.noirbykriszta.hu")


# ─────────────────────────  IDŐZÓNA  ────────────────────────
# Ettől lesz a "12:00" tényleg 12:00 magyar idő szerint (foglalások, emailek).
TZ=Europe/Budapest


# ────────────────────────  DUCKDNS  ─────────────────────────
# Csak amíg DuckDNS-t használsz. Kapcsold be a frissítő konténert:
COMPOSE_PROFILES=duckdns
# https://www.duckdns.org  →  bejelentkezés  →  aldomain + token
DUCKDNS_SUBDOMAIN=noirbykriszta
DUCKDNS_TOKEN=

# Saját domainre váltáskor: COMPOSE_PROFILES= (üresen hagyva kikapcsol)


# ───────────────────────  ADATBÁZIS  ───────────────────────
# Erős, véletlen jelszó. Az adat a `pgdata` docker volume-ban marad
# minden redeploy után — csak `docker compose down -v` törölné.
# Ezen felül naponta automatikus mentés készül a ./backups/ mappába.
POSTGRES_PASSWORD=


# ─────────────────────  ADMIN BELÉPÉS  ─────────────────────
# Az admin felület: https://<domain>/admin/login
ADMIN_EMAIL=kriszta@noirbykriszta.hu
ADMIN_PASSWORD=
# Megjegyzés: az admin fiók az ELSŐ indításkor jön létre ezekkel az értékekkel.
# Ha később módosítanál, lásd DEPLOYMENT.md „Admin jelszó módosítása".

# JWT aláíró titok — hosszú véletlen sztring (pl. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRES_IN=7d


# ──────────────────────  FOGLALÁS  ────────────────────────
# Ezek csak az ELSŐ indítás alapértékei — utána az admin felületről
# (Nyitvatartás & szünetek → Foglalási beállítások) módosíthatók, és
# a módosítás az adatbázisban marad redeploy után is.
SLOT_STEP_MINUTES=30
MIN_LEAD_HOURS=12


# ───────────────────────  EMAIL  ─────────────────────────
# A cél: a foglaló vendég ÉS Kriszta is emailt kapjon.
# Válassz EGY módot (SMTP vagy Resend). Ha egyiket sem töltöd ki,
# az emailek csak a szerver logjába íródnak (semmi nem hibázik).
#
#  ┌── A) GMAIL közvetlenül (App Password kell, 2FA-val bekapcsolva) ──┐
#  Google-fiók → Biztonság → 2FA be → Alkalmazásjelszavak → új
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
#  └──────────────────────────────────────────────────────────────────┘
#
#  ┌── B) BREVO (ingyenes 300 email/nap, jobb kézbesíthetőség) ──┐
#  SMTP_HOST=smtp-relay.brevo.com  (SMTP_USER/PASS a Brevo SMTP fülről)
#  └───────────────────────────────────────────────────────────┘
#
#  ┌── C) RESEND (csak saját, igazolt domainnel) ──┐
#  RESEND_API_KEY=re_xxxxxxxx
#  └──────────────────────────────────────────────┘

# Feladó cím — SMTP-nél EGYEZZEN a hitelesített feladóval (a Gmail cím)
MAIL_FROM=Noir by Kriszta <sajatcimed@gmail.com>
# Válasz-cím (ide írnak vissza a vendégek)
MAIL_REPLY_TO=kriszta@noirbykriszta.hu
# Ide érkeznek az admin értesítők (új foglalás, státuszváltás, üzenet)
OWNER_EMAIL=kriszta@noirbykriszta.hu
# A szalon címe az emailek láblécében
SALON_ADDRESS=2119 Pécel, Kossuth Lajos utca 12.


# ────────────────────────  EGYÉB  ───────────────────────
# Open Graph / megosztási kép (üresen hagyva egy alap képet használ)
OG_IMAGE_URL=
