# WordPress core
wp-admin/
wp-includes/
wp-*.php
index.php
license.txt
readme.html
xmlrpc.php

# Sensitive files
wp-config.php
.env
*.sql
*.sqlite
*.zip
*.tar.gz

# Uploads, cache, backups
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup*/
wp-content/backups/
wp-content/ai1wm-backups/

# Logs
*.log
debug.log

# OS/editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# LocalWP / local server files
.htaccess
local-xdebuginfo.php

# Installed plugins should not be committed,
# except the custom Noir plugins maintained in this repository.
wp-content/plugins/*
!wp-content/plugins/noir-blog-system/
!wp-content/plugins/noir-blog-system/**
!wp-content/plugins/noir-blog-theme-header-fix/
!wp-content/plugins/noir-blog-theme-header-fix/**
!wp-content/plugins/noir-global-elementor-header/
!wp-content/plugins/noir-global-elementor-header/**
